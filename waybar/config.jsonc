{
  // Top bar
  "position": "top",

  // Modules
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "custom/bluetooth",
    "pulseaudio",
    "battery",
    "custom/power"
  ],

  // Format
  "clock": {
    "format": "{:%d/%m %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month"
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "cpu": {
    "format": " {usage}%"
  },
  "memory": {
    "format": " {}%"
  },
  "network": {
    "format": "󰖩 {ipaddr}",
    "format-disconnected": "󰖪 ",
    "on-click": "nm-connection-editor"
  },
  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/bluetooth-status.sh",
    "interval": 5,
    "return-type": "json",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " ",
    "on-click": "pavucontrol"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },
  "custom/power": {
    "format": "",
    "tooltip-format": "Power off",
    "on-click": "systemctl poweroff"
  }
}
